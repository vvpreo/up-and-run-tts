# Скопируйте в .env и задайте свои значения: docker compose читает его сам.
# Стенд: prod | dev | test | uat (на непродовых — цветная рамка на иконке)
APP_ENV=prod
# Bearer-токен API. Пусто = действуют только ключи из админки; нет и их — API открыт.
AUTH_TOKEN=
# Админка /admin (basic-auth). Пустой пароль = админка выключена.
ADMIN_USER=admin
ADMIN_PASSWORD=
